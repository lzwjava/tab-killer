{
  "manifest_version": 3,
  "name": "Tabs Killer",
  "description": "Automatically kill the oldest tabs when tabs are too many.",
  "version": "1.0",
  "action": {
    "default_icon": "img/icon128.png",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "img/icon128.png",
    "48": "img/icon48.png",
    "16": "img/icon16.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["storage", "tabs"]
}